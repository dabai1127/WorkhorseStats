    <SolidColorBrush x:Key="C_91968C" Color="#91968C"/>
    <SolidColorBrush x:Key="C_919788" Color="#919788"/>
    <SolidColorBrush x:Key="C_91978A" Color="#91978A"/>
    <SolidColorBrush x:Key="C_929B89" Color="#929B89"/>
    <SolidColorBrush x:Key="C_947B67" Color="#947B67"/>
    <SolidColorBrush x:Key="C_94998C" Color="#94998C"/>
    <SolidColorBrush x:Key="C_9A9F91" Color="#9A9F91"/>
    <SolidColorBrush x:Key="C_9AA18F" Color="#9AA18F"/>
    <SolidColorBrush x:Key="C_9DA292" Color="#9DA292"/>
    <SolidColorBrush x:Key="C_A0A594" Color="#A0A594"/>
    <SolidColorBrush x:Key="C_A9BEAA" Color="#A9BEAA"/>
    <SolidColorBrush x:Key="C_AB896D" Color="#AB896D"/>
    <SolidColorBrush x:Key="C_AD9480" Color="#AD9480"/>
    <SolidColorBrush x:Key="C_B7C9B7" Color="#B7C9B7"/>
    <SolidColorBrush x:Key="C_B9CABB" Color="#B9CABB"/>
    <SolidColorBrush x:Key="C_CBDBB4" Color="#CBDBB4"/>
    <SolidColorBrush x:Key="C_D0DCB7" Color="#D0DCB7"/>
    <SolidColorBrush x:Key="C_D2DFA0" Color="#D2DFA0"/>
    <SolidColorBrush x:Key="C_DCE1D1" Color="#DCE1D1"/>
    <SolidColorBrush x:Key="C_E1E4D8" Color="#E1E4D8"/>
    <SolidColorBrush x:Key="C_E1E4D9" Color="#E1E4D9"/>
    <SolidColorBrush x:Key="C_E5E9DE" Color="#E5E9DE"/>
    <SolidColorBrush x:Key="C_E8EBDE" Color="#E8EBDE"/>
    <SolidColorBrush x:Key="C_E9EBE2" Color="#E9EBE2"/>
