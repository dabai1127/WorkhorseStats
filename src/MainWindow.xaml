    <SolidColorBrush x:Key="C_F6F5EF" Color="#F6F5EF"/>
    <SolidColorBrush x:Key="Ink" Color="#24352E" />
    <SolidColorBrush x:Key="Muted" Color="#8A9188" />
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource C_546157}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource C_E9EBE2}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.3"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="29"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource C_8A9188}"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource C_24352E}"/><Setter Property="Background" Value="{DynamicResource C_EEEFE6}"/><Setter Property="BorderBrush" Value="{DynamicResource C_E1E4D9}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource C_EEEFE6}" BorderBrush="{DynamicResource C_E1E4D9}" BorderThickness="1" CornerRadius="6"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Foreground="{DynamicResource C_8A9188}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Margin="9,0,25,0" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource C_EEEFE6}" BorderBrush="{DynamicResource C_E1E4D9}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource C_24352E}"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="7,5"/><Setter Property="Foreground" Value="{DynamicResource C_24352E}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource C_E5E9DE}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource C_E1E4D9}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid x:Name="FullRoot" Margin="22,12,22,10">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="39"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Grid x:Name="DragArea" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="31" Height="31" Margin="0,0,9,0">
              <Canvas Width="36" Height="36">
                <Path Fill="{DynamicResource C_243D32}" Data="M 8,12 C 3,12 2,5 5,4 L 12,9 C 15,6 21,6 24,9 L 31,4 C 34,5 33,12 28,12 L 29,24 C 28,32 8,32 7,24 Z"/>
                <Ellipse Fill="{DynamicResource C_F6F5EF}" Width="19" Height="10" Canvas.Left="8.5" Canvas.Top="20"/>
                <Ellipse Fill="{DynamicResource C_F6F5EF}" Width="3" Height="3" Canvas.Left="11" Canvas.Top="14"/>
                <Ellipse Fill="{DynamicResource C_F6F5EF}" Width="3" Height="3" Canvas.Left="22" Canvas.Top="14"/>
                <Ellipse Fill="{DynamicResource C_243D32}" Width="2" Height="3" Canvas.Left="13" Canvas.Top="23"/>
                <Ellipse Fill="{DynamicResource C_243D32}" Width="2" Height="3" Canvas.Left="21" Canvas.Top="23"/>
                <Ellipse Fill="{DynamicResource C_EBA66C}" Width="6" Height="6" Canvas.Left="27" Canvas.Top="25"/>
              </Canvas>
            </Viewbox>
            <StackPanel><TextBlock Text="牛马统计" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="把忙碌，算清楚。" FontSize="9" Foreground="{DynamicResource C_899187}" Margin="0,2,0,0"/></StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="窗口置顶"/>
            <Button x:Name="CompactButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="切换迷你窗"/>
            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="最小化"/>
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="收起到托盘"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DateText" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="WeekText" FontSize="10" Foreground="{DynamicResource C_91968C}" Margin="9,4,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="前一天"/><Button x:Name="TodayButton" Content="今天" FontSize="10" Padding="8,5"/><Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="后一天"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,2,0,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="OverviewTab" Content="总览" Background="{DynamicResource C_E5E9DE}" Foreground="{DynamicResource C_2B4737}" Padding="16,6" FontSize="11" FontWeight="SemiBold" Margin="0,0,5,0"/>
            <Button x:Name="AppsTab" Content="软件" Padding="16,6" FontSize="11" Margin="0,0,5,0"/>
            <Button x:Name="TrendsTab" Content="趋势" Padding="16,6" FontSize="11"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource C_5D9564}" Margin="0,0,5,0"/><TextBlock x:Name="StatusText" Text="正在记录" FontSize="10" Foreground="{DynamicResource C_768271}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="3">
          <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto" Padding="0,0,0,2">
            <StackPanel>
              <Border Background="{DynamicResource C_223F35}" CornerRadius="17" Padding="20,16,20,15">
                <StackPanel>
                  <Grid><TextBlock Text="屏幕活跃时间" Foreground="{DynamicResource C_B9CABB}" FontSize="11"/><Border HorizontalAlignment="Right" Background="{DynamicResource C_365447}" CornerRadius="5" Padding="6,3"><TextBlock x:Name="HeroTag" Text="TODAY" Foreground="{DynamicResource C_D0DCB7}" FontFamily="Bahnschrift" FontSize="8"/></Border></Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                    <TextBlock x:Name="HoursText" Text="0" FontFamily="Bahnschrift" FontSize="45" Foreground="{DynamicResource C_F3F5E5}"/>
                    <TextBlock Text="时" FontSize="12" Foreground="{DynamicResource C_B7C9B7}" Margin="5,26,12,0"/>
                    <TextBlock x:Name="MinutesText" Text="00" FontFamily="Bahnschrift" FontSize="45" Foreground="{DynamicResource C_F3F5E5}"/>
                    <TextBlock Text="分" FontSize="12" Foreground="{DynamicResource C_B7C9B7}" Margin="5,26,0,0"/>
                    <TextBlock x:Name="ActivePercent" Text="0% 活跃" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="{DynamicResource C_CBDBB4}" VerticalAlignment="Bottom" Margin="20,0,0,9"/>
                  </StackPanel>
                  <Grid Height="5" Margin="0,0,0,9"><Border Background="{DynamicResource C_415B49}" CornerRadius="3"/><Border x:Name="HeroProgress" Background="{DynamicResource C_D2DFA0}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Grid>
                  <Grid><TextBlock x:Name="ScreenText" Text="开屏 0 分钟" FontSize="10" Foreground="{DynamicResource C_A9BEAA}"/><TextBlock x:Name="IdleText" Text="离开 0 分钟" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource C_A9BEAA}"/></Grid>
                </StackPanel>
              </Border>
              <Grid Margin="0,10,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource C_EFEEE5}" CornerRadius="13" Padding="15,12">
                  <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource C_7E8B6C}" Margin="0,1,6,0"/><TextBlock Text="键盘敲击" FontSize="11" Foreground="{DynamicResource C_737F6D}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="KeysText" Text="0" FontFamily="Bahnschrift" FontSize="26"/><TextBlock Text="次" FontSize="10" Foreground="{DynamicResource C_91978A}" Margin="6,13,0,0"/></StackPanel><TextBlock x:Name="KeyRateText" Text="等待第一下敲击" FontSize="9" Foreground="{DynamicResource C_94998C}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource C_F2EADF}" CornerRadius="13" Padding="15,12">
                  <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource C_AB896D}" Margin="0,1,6,0"/><TextBlock Text="鼠标点击" FontSize="11" Foreground="{DynamicResource C_947B67}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="ClicksText" Text="0" FontFamily="Bahnschrift" FontSize="26"/><TextBlock Text="次" FontSize="10" Foreground="{DynamicResource C_AD9480}" Margin="6,13,0,0"/></StackPanel><TextBlock x:Name="MouseSubText" Text="滚动 0 格 · 移动 0 px" FontSize="9" Foreground="{DynamicResource C_AD9480}" Margin="0,4,0,0"/></StackPanel>
                </Border>
              </Grid>
              <Grid Margin="1,0,1,9"><TextBlock Text="时间都去哪了" Style="{StaticResource SectionTitle}"/><Button x:Name="AllAppsButton" Content="全部软件 →" FontSize="10" Foreground="{DynamicResource C_899181}" HorizontalAlignment="Right" Padding="4,0"/></Grid>
              <StackPanel x:Name="TopAppsPanel"/>
              <Border x:Name="EmptyApps" Background="{DynamicResource C_EEEFE7}" CornerRadius="10" Padding="14,19" Visibility="Collapsed"><StackPanel><TextBlock Text="今天的故事，刚刚开始。" FontSize="12" Foreground="{DynamicResource C_778271}"/><TextBlock Text="用一会儿电脑，软件排行就会出现在这里。" FontSize="10" Foreground="{DynamicResource C_9AA18F}" Margin="0,6,0,0"/></StackPanel></Border>
              <Border BorderBrush="{DynamicResource C_E1E4D8}" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="1,12,1,0">
                <StackPanel><Grid><TextBlock Text="今日节奏" Style="{StaticResource SectionTitle}"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><Rectangle Width="6" Height="6" Fill="{DynamicResource C_75916C}" Margin="0,0,4,0"/><TextBlock Text="活跃" FontSize="9" Foreground="{DynamicResource C_9A9F91}"/><Rectangle Width="6" Height="6" Fill="{DynamicResource C_DCE1D1}" Margin="9,0,4,0"/><TextBlock Text="开屏" FontSize="9" Foreground="{DynamicResource C_9A9F91}"/></StackPanel></Grid><Grid x:Name="HourlyChart" Height="42" Margin="0,8,0,0"/><Grid Margin="0,5,0,0"><TextBlock Text="00" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource C_9DA292}"/><TextBlock Text="06" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource C_9DA292}" HorizontalAlignment="Left" Margin="104,0,0,0"/><TextBlock Text="12" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource C_9DA292}" HorizontalAlignment="Center"/><TextBlock Text="18" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource C_9DA292}" HorizontalAlignment="Right" Margin="0,0,96,0"/><TextBlock Text="24" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource C_9DA292}" HorizontalAlignment="Right"/></Grid></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="AppsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,5,0,15"><TextBlock Text="每一分钟，都有去处。" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AppsSummaryText" FontSize="11" Foreground="{DynamicResource C_909788}" Margin="0,7,0,0"/><StackPanel x:Name="CategorySummaryPanel" Margin="0,12,0,9"/><Grid><ComboBox x:Name="CategoryFilter" Width="120" Height="27" HorizontalAlignment="Left" FontSize="10" Background="{DynamicResource C_EEEFE6}"/><Button x:Name="CategoriesButton" Content="管理分类 ↗" HorizontalAlignment="Right" FontSize="10" Padding="8,5"/></Grid></StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="AppListPanel"/><StackPanel x:Name="AppPager" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"><Button x:Name="AppPagePrev" Content="上一页" FontSize="10"/><TextBlock x:Name="AppPageText" FontSize="10" VerticalAlignment="Center" Margin="9,0"/><Button x:Name="AppPageNext" Content="下一页" FontSize="10"/></StackPanel></StackPanel></ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource C_EBEDE2}" CornerRadius="12" Padding="14" Margin="0,15,0,4"><StackPanel><TextBlock Text="输入足迹" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="MouseDetailText" FontSize="10" Foreground="{DynamicResource C_86917D}" Margin="0,7,0,0"/><TextBlock x:Name="DistanceText" FontSize="10" Foreground="{DynamicResource C_86917D}" Margin="0,5,0,0"/></StackPanel></Border>
          </Grid>
          <ScrollViewer x:Name="TrendsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="忙碌，也有自己的节奏。" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrendRangeText" FontSize="11" Foreground="{DynamicResource C_919788}" Margin="0,7,0,18"/>
            <Border Background="{DynamicResource C_ECEFE3}" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="最近 7 天 · 屏幕活跃" FontSize="12" FontWeight="SemiBold"/><Grid x:Name="WeekChart" Height="155" Margin="0,16,0,0"/><TextBlock x:Name="WeekTotalText" FontSize="10" Foreground="{DynamicResource C_818D75}" Margin="0,14,0,0"/></StackPanel></Border>
            <TextBlock Text="逐时明细" Style="{StaticResource SectionTitle}" Margin="1,22,0,11"/><StackPanel x:Name="HourDetailPanel"/>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid Grid.Row="4" Margin="0,9,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PauseButton" Content="Ⅱ  暂停" Background="{DynamicResource C_E8EBDE}" FontSize="10" Padding="10,6"/><Button x:Name="ExportButton" Content="&#xE896;" Style="{StaticResource IconButton}" ToolTip="导出当前日期 CSV" Margin="5,0,0,0"/><Button x:Name="ReportButton" Content="日报" FontFamily="Microsoft YaHei UI" FontSize="10" Width="38" Style="{StaticResource IconButton}" ToolTip="生成牛马日报"/><Button x:Name="DataButton" Content="数据" FontFamily="Microsoft YaHei UI" FontSize="10" Width="38" Style="{StaticResource IconButton}" ToolTip="数据管理 · 备份与恢复"/></StackPanel>
          <TextBlock x:Name="PrivacyText" Text="仅计次数 · 数据留在本机" FontSize="9" Foreground="{DynamicResource C_A0A594}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <Grid x:Name="MiniRoot" Visibility="Collapsed" Margin="18,12">
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
        <Grid x:Name="MiniDragArea" Background="Transparent"><TextBlock Text="牛马统计" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="展开"/><Button x:Name="MiniCloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="收起到托盘"/></StackPanel></Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="MiniTimeText" Text="0h 00m" FontFamily="Bahnschrift" FontSize="35"/><TextBlock x:Name="MiniMetricsText" Text="键盘 0 · 鼠标 0" FontSize="10" Foreground="{DynamicResource C_929B89}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="2"><TextBlock x:Name="MiniStatusText" Text="● 正在记录" FontSize="10" Foreground="{DynamicResource C_72916B}" VerticalAlignment="Center"/><Button x:Name="MiniPauseButton" Content="暂停" FontSize="10" HorizontalAlignment="Right" Padding="8,3"/></Grid>
      </Grid>
      <Border x:Name="DockRoot" Visibility="Collapsed" Background="{DynamicResource C_223F35}" CornerRadius="10" ToolTip="移入展开牛马统计"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="牛" FontSize="15" Foreground="{DynamicResource C_D2DFA0}" HorizontalAlignment="Center"/><TextBlock x:Name="DockTimeText" Text="0h" FontFamily="Bahnschrift" FontSize="10" Foreground="{DynamicResource C_B9CABB}" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
    </Grid>
  </Border>
</Window>
