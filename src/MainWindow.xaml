<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="牛马统计" Width="492" Height="744" MinWidth="440" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource C_F6F5EF}" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource C_24352E}">
  <Window.Resources>
    <SolidColorBrush x:Key="C_223F35" Color="#223F35"/>
    <SolidColorBrush x:Key="C_24352E" Color="#24352E"/>
    <SolidColorBrush x:Key="C_243D32" Color="#243D32"/>
    <SolidColorBrush x:Key="C_2B4737" Color="#2B4737"/>
